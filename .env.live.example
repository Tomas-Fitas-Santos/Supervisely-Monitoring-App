# Created with scripts/init-live-test.ps1. Never commit the populated .env.live.
POSTGRES_USER=nightjar
POSTGRES_DB=nightjar
POSTGRES_PASSWORD=GENERATE_WITH_SCRIPT
NIGHTJAR_ENCRYPTION_KEY=GENERATE_WITH_SCRIPT
APP_ENV=production
# Prefer a non-OneDrive drive for large video collections, e.g. D:/NightjarLiveMedia
NIGHTJAR_MEDIA_DIR=./.nightjar-live-data

SUPERVISELY_ALLOWED_HOSTS=app.supervisely.com
MAX_DATASET_BYTES=140000000000
MAX_DATASET_ASSETS=250000

# Approved addresses here are placeholders for the CI disposable environment.
NIGHTJAR_ADMIN_EMAILS=admin@example.invalid
NIGHTJAR_ORGANISER_EMAILS=
NIGHTJAR_PUBLIC_URL=
NIGHTJAR_SMTP_HOST=
NIGHTJAR_SMTP_PORT=587
NIGHTJAR_SMTP_USER=
NIGHTJAR_SMTP_PASSWORD=
NIGHTJAR_SMTP_FROM=
