# LOCAL DEVELOPMENT ONLY. Copy to .env and replace every placeholder.
POSTGRES_USER=annotatiathon
POSTGRES_DB=annotatiathon
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://annotatiathon:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/annotatiathon
APP_ENV=local

# Native Supervisely API access uses an organiser token locally on the backend.
# Uncomment and set only in your untracked .env file, never in Git:
# SUPERVISELY_API_TOKEN=YOUR_REAL_TOKEN
# For a trusted self-hosted/Enterprise Supervisely instance, add its HTTPS host:
# SUPERVISELY_ALLOWED_HOSTS=app.supervisely.com,supervisely.your-organisation.example
