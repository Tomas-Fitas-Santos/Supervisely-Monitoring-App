# LOCAL DEVELOPMENT ONLY. Copy to .env and replace every placeholder.
POSTGRES_USER=annotatiathon
POSTGRES_DB=annotatiathon
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://annotatiathon:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/annotatiathon
APP_ENV=local

# Local secure application secrets. Generate once and keep this Fernet key
# stable for the life of the deployment (separate from the database backups):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NIGHTJAR_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# SMTP used to verify monitor email ownership at account registration.
# These are server-side service credentials, not Supervisely API tokens.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_SSL=false

# Organisers configure Supervisely Team ID, Workspace ID and shared API
# token inside the app under Settings. No Supervisely API token in .env.
# For trusted self-hosted/Enterprise Supervisely:
# SUPERVISELY_ALLOWED_HOSTS=app.supervisely.com,supervisely.your-organisation.example
