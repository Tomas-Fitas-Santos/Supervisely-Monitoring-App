# Use a persistent PostgreSQL database reachable from the Supervisely agent.
DATABASE_URL=postgresql+psycopg://monitor:CHANGE_ME@database:5432/monitor
MONITORING_TEAM_ID=123
# Platform supplies SERVER_ADDRESS and API_TOKEN for the app session.
SERVER_ADDRESS=https://app.supervisely.com
# Separate server-only credential with read access to every participating team.
SYNC_API_TOKEN=
POLL_INTERVAL_SECONDS=60
STALE_AFTER_SECONDS=180
# Local loopback testing (synthetic demo or real API pilot). Never enable in a hosted app.
LOCAL_DEVELOPMENT=false
LOCAL_USER_ID=
API_TOKEN=
# Server-side temporary upload chunks. Use shared persistent storage if running multiple app processes.
UPLOAD_STAGING_DIR=data/uploads
# Maximum size of a single selected browser file, in MiB.
UPLOAD_MAX_FILE_MB=1024
