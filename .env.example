# Optional deployment infrastructure. Fresh local pilots need no .env:
# run the app and connect/create groups through its UI.
# Hosted sessions need persistent PostgreSQL reachable from the Supervisely agent.
DATABASE_URL=postgresql+psycopg://monitor:CHANGE_ME@database:5432/monitor
# Platform provides each hosted user's SERVER_ADDRESS/API credential.
# Optional server-only hosted polling credential with access to all participant teams.
# Automatic deadline closure also requires permission to stop their labeling jobs.
SYNC_API_TOKEN=
POLL_INTERVAL_SECONDS=60
STALE_AFTER_SECONDS=180
# Shared persistent temporary storage if running multiple app processes.
UPLOAD_STAGING_DIR=data/uploads
UPLOAD_MAX_FILE_MB=1024
# Legacy MONITORING_TEAM_ID/API_TOKEN/local-demo settings are accepted for compatibility.
# Do not configure event groups, people or assignments here.
