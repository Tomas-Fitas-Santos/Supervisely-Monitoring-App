# Copy to .env.external; NEVER commit the filled-in file.
# Point a DNS A record for this host to your externally hosted Docker server.
APP_DOMAIN=monitor.your-domain.example
EXTERNAL_PUBLIC_ORIGIN=https://monitor.your-domain.example

# Existing live Supervisely Pro team and organiser's API credential
SERVER_ADDRESS=https://app.supervisely.com
EXTERNAL_TEAM_ID=125980
EXTERNAL_ORGANISER_EMAIL=tomas.dos.santos@tecnico.ulisboa.pt
SUPERVISELY_SERVICE_TOKEN=REPLACE_WITH_YOUR_REAL_SUPERVISELY_ADMIN_API_TOKEN

# Generate a random 48-byte hex secret:
# python -c "import secrets; print(secrets.token_hex(48))"
EXTERNAL_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Keep these two values identical (use an alphanumeric-only password for URL safety).
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql+psycopg://monitor:REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD@database:5432/monitor

# Email delivery. Choose SMTP TLS port 587 or implicit TLS port 465.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_FROM=annotatiathon@your-domain.example
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
