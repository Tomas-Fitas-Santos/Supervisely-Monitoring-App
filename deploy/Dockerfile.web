# Builds the checked-in React/Vite frontend; serves it from one origin
# with the FastAPI backend so CSRF and secure session cookies work.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json /web/package.json
RUN npm install --no-audit --no-fund
COPY web/ /web/
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-live.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
EXPOSE 80
